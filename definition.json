            },
            "actions": {
                "Obtener_contenido_de_archivo": {
                    "runAfter": {},
                    "type": "OpenApiConnection",
                    "inputs": {
                        "parameters": {
                            "id": "@triggerOutputs()?['headers/x-ms-file-id']",
                            "inferContentType": true
                        },
                        "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
                            "connectionName": "shared_onedriveforbusiness",
                            "operationId": "GetFileContent"
                        },
                        "authentication": "@parameters('$authentication')"
                    }
                },
                "Redactar": {
                    "runAfter": {
                        "Obtener_contenido_de_archivo": [
                            "Succeeded"
                        ]
                    },
                    "type": "Compose",
                    "inputs": "@first(split(body('Obtener_contenido_de_archivo'), decodeUriComponent('%0D%0A')))"
                },
                "Condición": {
                    "actions": {
                        "Copiar_archivo": {
                            "type": "OpenApiConnection",
                            "inputs": {
                                "parameters": {
                                    "id": "@triggerOutputs()?['headers/x-ms-file-id']",
                                    "destination": "/Datos_Procesados/test.csv",
                                    "overwrite": true
                                },
                                "host": {
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
                                    "connectionName": "shared_onedriveforbusiness",
                                    "operationId": "CopyDriveFile"
                                },
                                "authentication": "@parameters('$authentication')"
                            }
                        },
                        "Enviar_correo_electrónico_(V2)_1": {
                            "runAfter": {
                                "Copiar_archivo": [
                                    "Succeeded"
                                ]
                            },
                            "type": "OpenApiConnection",
                            "inputs": {
                                "parameters": {
                                    "emailMessage/To": "diana.fuentealba.s@gmail.com",
                                    "emailMessage/Subject": "El csv esta perfecto",
                                    "emailMessage/Body": "<p class=\"editor-paragraph\">Todo ok con el archivo<br><br>@{outputs('Redactar')}</p>",
                                    "emailMessage/Importance": "Normal"
                                },
                                "host": {
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                                    "connectionName": "shared_office365",
                                    "operationId": "SendEmailV2"
                                },
                                "authentication": "@parameters('$authentication')"
                            }
                        }
                    },
                    "runAfter": {
                        "Redactar": [
                            "Succeeded"
                        ]
                    },
                    "else": {
                        "actions": {
                            "Enviar_correo_electrónico_(V2)": {
                                "type": "OpenApiConnection",
                                "inputs": {
                                    "parameters": {
                                        "emailMessage/To": "diana.fuentealba.s@gmail.com",
                                        "emailMessage/Subject": "El CSV tiene errores",
                                        "emailMessage/Body": "<p class=\"editor-paragraph\">Revisar encabezados.</p><br><p class=\"editor-paragraph\">@{outputs('Redactar')}</p><br><p class=\"editor-paragraph\">Encabezados esperados<br><br>SKU,Producto,Precio Unitario,Stock</p>",
                                        "emailMessage/Importance": "Normal"
                                    },
                                    "host": {
                                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                                        "connectionName": "shared_office365",
                                        "operationId": "SendEmailV2"
                                    },
                                    "authentication": "@parameters('$authentication')"
                                }
                            }
                        }
                    },
                    "expression": {
                        "and": [
                            {
                                "equals": [
                                    "@outputs('Redactar')",
                                    "SKU,Producto,Precio Unitario,Stock"
                                ]
                            }
                        ]
                    },
                    "type": "If"
                }
